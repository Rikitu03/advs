# ADVS ML API — environment surface (copy to python/.env.api for local runs;
# on a Hugging Face Space these are set as Repository secrets / variables).
# Every value is optional except API_TOKEN; unset model paths fall back to the
# canonical filenames under MODEL_DIR and simply report "not loaded" until the
# trained weights exist.

# --- auth (REQUIRED for all /v1/* endpoints; /health stays open) ---
API_TOKEN=change-me

# --- model locations (configure once training finishes) ---
# MODEL_DIR=./models
# MODEL_MANIFEST_PATH=./models/manifest.json
# CLASSIFIER_MODEL_PATH=./models/resnet50_best.keras
# CLASS_NAMES_PATH=./models/class_names.json
# DETECTOR_MODEL_PATH=./models/yolov8_nano_moredata_best.pt
# Optional dedicated single-class detector for three-signature registration photos.
# Registration uses this dedicated detector by default. Set this to another
# compatible YOLO model to override it. If the default artifact is unavailable,
# enrollment falls back to DETECTOR_MODEL_PATH.
# SIGNATURE_ENROLL_DETECTOR_MODEL_PATH=./models/signature_detector_best_raw.pt
# SIAMESE_MODEL_PATH=./models/siamese_encoder.h5           # the ENCODER (the API only embeds)
# STAMP_MODEL_PATH=./models/efficientnet_feature_extractor.h5
# SIGNATURE_THRESHOLD_PATH=./models/signature_threshold.txt
# STAMP_THRESHOLD_PATH=./models/stamp_threshold.txt
# Two TrOCR recognizers, routed per OCR template (local snapshot dirs only,
# never a bare HF Hub id). base and large agree exactly on DTI/Business Permit
# with base ~3x faster; only BIR needs the accurate model. Either one missing
# falls back to the other.
# TROCR_MODEL_PATH=./models/trocr-base-printed              # the default/fast recognizer
# TROCR_ACCURATE_MODEL_PATH=./models/trocr-large-printed    # used for TROCR_ACCURATE_TEMPLATES
# TROCR_ACCURATE_TEMPLATES=bir                              # comma-separated

# --- tunable thresholds (docs/ADVS_REFERENCE.md §9 defaults) ---
# CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70
# YOLO_DETECTION_CONFIDENCE=0.50
# Enrollment-only calibration; does not alter Stage 4 document detection.
# SIGNATURE_ENROLL_DETECTION_CONFIDENCE=0.20
# SIGNATURE_ENROLL_DETECTION_IMGSZ=1280
# STAMP_SIMILARITY_THRESHOLD=0.85
# STAMP_TAMPER_THRESHOLD=0.50
# SIGNATURE_DISTANCE_THRESHOLD=      # empirical; falls back to SIGNATURE_THRESHOLD_PATH
# PDF_DPI=300
# MAX_PDF_PAGES=2
# MAX_FILE_SIZE_MB=10

# --- Stage 2 ROI+TrOCR pass (cost bounds, NOT §9 scoring parameters) ---
# Each field crop is ~10-30s of CPU inference. The budget caps the whole pass
# per page; fields it cannot reach keep their label+regex value (fail-forward).
# ROI_BUDGET_SECONDS=45
# TROCR_MAX_NEW_TOKENS=64            # 32 truncated a real 70-char address; generation stops at EOS anyway
# ROI_TESSERACT_CONFIDENCE_FLOOR=90  # skip TrOCR only on a near-certain Tesseract read — see README


# --- runtime ---
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# NUM_THREADS=                       # default: min(4, cpu_count) — 2 on the HF free tier, 4 on Oracle A1
# Where PATCH /v1/config persists admin threshold overrides (survives restarts,
# but not a container rebuild — Laravel's settings stay canonical).
# THRESHOLD_STORE_PATH=./.thresholds.json
