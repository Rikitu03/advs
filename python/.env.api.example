# ADVS ML API — environment surface (copy to python/.env.api for local runs;
# on a Hugging Face Space these are set as Repository secrets / variables).
# Every value is optional except API_TOKEN; unset model paths fall back to the
# canonical filenames under MODEL_DIR and simply report "not loaded" until the
# trained weights exist.

# --- auth (REQUIRED for all /v1/* endpoints; /health stays open) ---
API_TOKEN=change-me

# --- model locations (configure once training finishes) ---
# MODEL_DIR=./models
# CLASSIFIER_MODEL_PATH=./models/resnet50_best.keras
# CLASS_NAMES_PATH=./models/class_names.json
# DETECTOR_MODEL_PATH=./models/yolov8_document.pt
# SIAMESE_MODEL_PATH=./models/siamese_encoder.h5           # the ENCODER (the API only embeds)
# STAMP_MODEL_PATH=./models/efficientnet_feature_extractor.h5
# SIGNATURE_THRESHOLD_PATH=./models/signature_threshold.txt
# STAMP_THRESHOLD_PATH=./models/stamp_threshold.txt

# --- tunable thresholds (ADVS_System_Reference.md §9 defaults) ---
# CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70
# YOLO_DETECTION_CONFIDENCE=0.50
# STAMP_SIMILARITY_THRESHOLD=0.85
# SIGNATURE_DISTANCE_THRESHOLD=      # empirical; falls back to SIGNATURE_THRESHOLD_PATH
# PDF_DPI=300

# --- runtime ---
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# NUM_THREADS=2                      # HF free tier is CPU-limited; don't oversubscribe
# Where PATCH /v1/config persists admin threshold overrides (survives restarts,
# but not a container rebuild — Laravel's settings stay canonical).
# THRESHOLD_STORE_PATH=./.thresholds.json
